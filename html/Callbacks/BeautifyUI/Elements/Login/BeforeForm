# Generate flag HTML entity pair from ISO-2 code (e.g. 'DE' → &#x1F1E9;&#x1F1EA;)
my $flag_html = sub {
    my ($code) = @_;
    $code = uc($code);
    return '' unless $code =~ /^[A-Z]{2}$/;
    my @c = split //, $code;
    return sprintf( '&#x%X;&#x%X;',
        0x1F1E6 + ord($c[0]) - 65,
        0x1F1E6 + ord($c[1]) - 65 );
};

# Flag(s) for a single country name string
my $flag_for = sub {
    my ($name) = @_;
    $name =~ s/^\s+|\s+$//g;
    my $code = $CC{$name};
    return $code ? $flag_html->($code) : '';
};

# Extract flags from a parenthesized country hint inside a description
# e.g. "Anzac Day (Australia/NZ) honors..." → "&#x...;&#x...;" for AU + NZ
my $flags_from_hint = sub {
    my ($desc) = @_;
    return '' unless $desc =~ /\(([^)]+)\)/;
    my $hint = $1;
    my @parts = split m{/|\s+and\s+|,\s*}, $hint;
    my ( @flags, %seen );
    for my $p (@parts) {
        $p =~ s/^\s+|\s+$//g;
        my $f = $flag_for->($p);
        push @flags, $f if $f && !$seen{$f}++;
    }
    return join( '&#x200B;', @flags );    # zero-width space between flags
};

# Flags for a full countries field (split by middle-dot)
# Returns globe entity for >5 countries or "worldwide" entries
my $flags_for_countries = sub {
    my ($countries) = @_;
    return '&#x1F30D;'
        if $countries =~ /worldwide|all countries|islamic countries|EU member/i;
    my $sep   = "\x{00b7}";
    my @parts = split /\s*\Q$sep\E\s*/, $countries;
    return '&#x1F30D;' if @parts > 6;
    my ( @flags, %seen );
    for my $p (@parts) {
        $p =~ s/^\s+|\s+$//g;
        $p =~ s/\s*\([^)]*\)//g;    # strip "(some cantons)" qualifiers
        # also strip sub-region notation like "BY·BW·..."
        $p =~ s/\s*\(.*//;
        my $f = $flag_for->($p);
        push @flags, $f if $f && !$seen{$f}++;
    }
    return @flags ? join( '&#x200B;', @flags ) : '&#x1F30D;';
};

# Build "&#xFLAG; Country · &#xFLAG; Country" HTML for the card header line
my $country_list_html = sub {
    my ($countries) = @_;
    return '&#x1F30D; Worldwide'
        if $countries =~ /worldwide|all countries/i;
    return '&#x1F30D; Islamic countries'
        if $countries =~ /islamic countries/i;
    return '&#x1F30D; EU member states'
        if $countries =~ /EU member/i;
    my $sep   = "\x{00b7}";
    my @parts = split /\s*\Q$sep\E\s*/, $countries;
    return '&#x1F30D; Multiple countries' if @parts > 6;
    my @items;
    for my $p (@parts) {
        $p =~ s/^\s+|\s+$//g;
        ( my $name = $p ) =~ s/\s*\([^)]*\)//g;
        my $code = $CC{$name};
        my $flag = $code ? $flag_html->($code) : '';
        push @items, ( $flag ? "$flag $name" : $name );
    }
    return join( ' &#xB7; ', @items );
};

sub _hol_truncate {
    my ( $text, $max ) = @_;
    return $text if length($text) <= $max;
    return substr( $text, 0, $max ) =~ s/\s+\S*$//r . ' ...';
}

sub _hol_csv_parse {
    my ($line) = @_;
    my @fields;
    while ( length $line ) {
        if ( $line =~ s/^"((?:[^"]|"")*)"(?:,|$)// ) {
            my $val = $1; $val =~ s/""/"/g; push @fields, $val;
        } elsif ( $line =~ s/^([^,]*)(?:,|$)// ) {
            push @fields, $1;
        } else { last }
    }
    return @fields;
}

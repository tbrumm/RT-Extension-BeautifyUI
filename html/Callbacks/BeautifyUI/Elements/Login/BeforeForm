use POSIX qw(strftime);

my $today    = strftime( "%m-%d", localtime );
my $today_display = strftime( "%B %d, %Y", localtime );
$today_display =~ s/ 0(\d),/ $1,/;    # "April 05" → "April 5"
my $csv_path = RT->Config->Get('HolidaysCSVPath')
              || $RT::LocalEtcPath . '/holidays-worldwide.csv';
my @found;

if ( -f $csv_path && open( my $fh, '<:encoding(UTF-8)', $csv_path ) ) {
    <$fh>;
    while ( my $line = <$fh> ) {
        chomp $line;
        my @f = _hol_csv_parse($line);
        next unless @f >= 5;
        my ( $date, $name, $countries, $type, $desc ) = @f;
        my $hit = 0;
        if ( $date =~ m{^(\d{2})-(\d{2})/(\d{2})$} ) {
            $hit = ( $today eq "$1-$2" || $today eq "$1-$3" );
        } else {
            $hit = ( $date eq $today );
        }
        push @found, { name => $name, countries => $countries,
                       type => $type, desc => $desc } if $hit;
    }
    close $fh;
}

